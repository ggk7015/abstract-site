# --- required ---
# Vercel Postgres / Neon / Supabase connection string
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- admin account (seeded automatically on first login) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# --- public site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/PgHdMYSxD

# --- optional: Discord message mirroring via bot ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- optional: shared secret for POST /api/ingest/discord ---
INGEST_SECRET=
