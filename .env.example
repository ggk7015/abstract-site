# 資安把關 / Secret hygiene
# 資訊安全需求：此檔為無害範本，僅可包含變數名稱與佔位值。
# 絕對不可填入真實 token、密碼或連線字串。
# CI 會執行 `npm run audit:secrets` 阻擋。

# --- 必要 ---
# Vercel Postgres / Neon / Supabase 連線字串（內含帳密，最高機敏）
DATABASE_URL=

# --- 管理員帳號（首次登入時自動建立）---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- 公開設定：僅限確實公開的內容 ---
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/PgHdMYSxD

# --- 選填：Discord 訊息鏡像（bot token 等同機器人完整權限）---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- 選填：內部排程 / 外部推送的共用密鑰 ---
INGEST_SECRET=
CRON_SECRET=
